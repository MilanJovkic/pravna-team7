# LLM Provider Configuration
# Options: "github" or "openrouter"
LLM_PROVIDER=github
LLM_MODEL=gpt-4o

# API Tokens
# For GitHub Models API (https://github.com/marketplace/models)
GITHUB_TOKEN=your_github_token_here

# For OpenRouter (https://openrouter.ai/)
